# 1. Set default behavior: auto-normalize all text files to LF in repo
* text=auto

# 2. Explicitly enforce LF line endings for scripts that execute in Unix/Linux
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.svelte text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.env text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.csv text eol=lf
*.md text eol=lf

# 2.1. Stylesheets & Vector Art (Enforce LF)
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf
*.svg text eol=lf

# 3. Explicitly enforce CRLF for Windows-specific script files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 4. Mark binary assets explicitly to prevent line ending corruption
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.7z binary
*.gz binary
*.exe binary
*.dll binary
*.so binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.mov binary
*.db binary
*.sqlite binary
